RewriteEngine On

# 旧サイト（WordPress時代）の /home/ 配下を現行ページへ恒久移転（301・2026-08-31 追加）
# https 統一より前に置く。後ろに置くと http で来た旧リンクが301を2回踏む。
# 入会案内に載せた /home/会員規約/ が 404 になっていたため。
# 日本語パスはリクエスト行にパーセントエンコードのまま届くので %{THE_REQUEST} で判定する。
# mod_rewrite は mod_alias（Redirect/RedirectMatch）より先に走るため、
# 最後のまとめ送りに食われないよう /home/ 配下は全て RewriteRule で書く。

# /home/会員規約/ → 現行の利用規約（%E4%BC%9A%E5%93%A1%E8%A6%8F%E7%B4%84 = 会員規約）
RewriteCond %{THE_REQUEST} \s/home/%E4%BC%9A%E5%93%A1%E8%A6%8F%E7%B4%84/?[\s?] [NC]
RewriteRule ^ https://bellmfit.com/terms-of-service/ [R=301,L]

# /home/施設紹介/ → べるフィット（%E6%96%BD%E8%A8%AD%E7%B4%B9%E4%BB%8B = 施設紹介）
RewriteCond %{THE_REQUEST} \s/home/%E6%96%BD%E8%A8%AD%E7%B4%B9%E4%BB%8B/?[\s?] [NC]
RewriteRule ^ https://bellmfit.com/services/fitness/ [R=301,L]

# /home/一般会員２４時間使い放題プラン/ → 料金
# （旧スラッグの「２４」が全角か半角か確かめられないため「一般会員」の前方一致で拾う）
RewriteCond %{THE_REQUEST} \s/home/%E4%B8%80%E8%88%AC%E4%BC%9A%E5%93%A1 [NC]
RewriteRule ^ https://bellmfit.com/price/ [R=301,L]

# ASCII パスの旧ページ
RewriteRule ^home/package-detail/?$ https://bellmfit.com/price/ [R=301,L,NC]
RewriteRule ^home/contact/?$ https://bellmfit.com/contact/ [R=301,L,NC]
RewriteRule ^home/about/?$ https://belltree1102.com/about/ [R=301,L,NC]

# /home/特定商取引法に基づく表記/ → 新設した表記ページ
RewriteCond %{THE_REQUEST} \s/home/%E7%89%B9%E5%AE%9A%E5%95%86%E5%8F%96%E5%BC%95%E6%B3%95%E3%81%AB%E5%9F%BA%E3%81%A5%E3%81%8F%E8%A1%A8%E8%A8%98/?[\s?] [NC]
RewriteRule ^ https://bellmfit.com/tokushoho/ [R=301,L]

# 残り（シニアフィットネス・べるフィットブログ 等）はトップへ。
# 個別の行き先が決まったら、このまとめ送りより上に1行ずつ足す。
RewriteRule ^home(/|$) https://bellmfit.com/ [R=301,L,NC]

# Search Console の404残り（/home/ 外の旧URL・2026-08-31 追加）
# 受け皿のある8件だけ301で拾う。/7172-2/ やカテゴリ・日付アーカイブは404のまま落とす。

# 旧鍼灸ブログ /shinkyu/ 配下ぜんぶ → 訪問鍼灸マッサージのページ
RewriteRule ^shinkyu(/|$) https://belltree1102.com/services/home-care/ [R=301,L,NC]

# /通所フィットネス/ → リーフ（%E9%80%9A%E6%89%80... = 通所フィットネス）
RewriteCond %{THE_REQUEST} \s/%E9%80%9A%E6%89%80%E3%83%95%E3%82%A3%E3%83%83%E3%83%88%E3%83%8D%E3%82%B9/?[\s?] [NC]
RewriteRule ^ https://bellmfit.com/services/leaf/ [R=301,L]

# /求人/ → 採用ページ（%E6%B1%82%E4%BA%BA = 求人）
RewriteCond %{THE_REQUEST} \s/%E6%B1%82%E4%BA%BA/?[\s?] [NC]
RewriteRule ^ https://belltree1102.com/recruit/ [R=301,L]

# /会社概要/ → 会社案内（%E4%BC%9A%E7%A4%BE%E6%A6%82%E8%A6%81 = 会社概要）
RewriteCond %{THE_REQUEST} \s/%E4%BC%9A%E7%A4%BE%E6%A6%82%E8%A6%81/?[\s?] [NC]
RewriteRule ^ https://belltree1102.com/about/ [R=301,L]

# 誤パスで拾われていた旧リンク
RewriteRule ^pages/services/home-care/?$ https://belltree1102.com/services/home-care/ [R=301,L,NC]

# http・www アクセスを https://bellmfit.com/ に統一（301）
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://bellmfit.com/$1 [R=301,L]

# 旧グループページは belltree1102.com / bellregal.com へ恒久移転（301）
# ロリポップでは実体フォルダが残っていると Redirect 形式が素通しになるため全て RedirectMatch 形式で書く
RedirectMatch 301 ^/services/?$ https://belltree1102.com/
RedirectMatch 301 ^/services/acupuncture(/.*)?$ https://belltree1102.com/services/home-visit/
RedirectMatch 301 ^/services/home-care(/.*)?$ https://belltree1102.com/services/home-care/
RedirectMatch 301 ^/services/legal(/.*)?$ https://bellregal.com/
RedirectMatch 301 ^/services/shukatsu(/.*)?$ https://bellregal.com/services/shukatsu/
RedirectMatch 301 ^/about(/.*)?$ https://belltree1102.com/about/
RedirectMatch 301 ^/team(/.*)?$ https://belltree1102.com/team/
RedirectMatch 301 ^/solutions(/.*)?$ https://belltree1102.com/solutions$1
RedirectMatch 301 ^/recruit(/.*)?$ https://belltree1102.com/recruit$1
RedirectMatch 301 ^/family(/.*)?$ https://belltree1102.com/
RedirectMatch 301 ^/community(/.*)?$ https://belltree1102.com/pro/
RedirectMatch 301 ^/cases(/.*)?$ https://belltree1102.com/
RedirectMatch 301 ^/news(/.*)?$ https://belltree1102.com/
RedirectMatch 301 ^/model(/.*)?$ https://belltree1102.com/about/

# ステージング（/test/）とスタッフ向け（/internal/）は検索結果に載せない
<IfModule mod_setenvif.c>
SetEnvIf Request_URI "^/test/" NOINDEX_AREA
SetEnvIf Request_URI "^/internal/" NOINDEX_AREA
</IfModule>
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_AREA
</IfModule>
